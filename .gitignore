def fetch_article(url: str, timeout=15) -> Optional[Article]:
    """
    Fetch an article from a URL.

    Args:
        url (str): The URL of the article.
        timeout (int): The timeout for the request.

    Returns:
        Optional[Article]: The article if successful, None otherwise.
    """
    try:
        response = requests.get(url, timeout=timeout)
        response.raise_for_status()
        return Article(response.text)
    except requests.RequestException as e:
        print(f"Error fetching article from {url}: {e}")
        return None

def fetch_articles(urls: List[str]) -> List[Article]:
    """
    Fetch multiple articles from a list of URLs.

    Args:
        urls (List[str]): The URLs of the articles.

    Returns:
        List[Article]: The list of articles.
    """
    articles = []
    for url in urls:
        article = fetch_article(url)
        if article:
            articles.append(article)
    return articles

